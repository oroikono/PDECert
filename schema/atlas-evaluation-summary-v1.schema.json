{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oroikono/PDECert/blob/main/schema/atlas-evaluation-summary-v1.schema.json",
  "title": "PDECert descriptive Atlas evaluation summary version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage",
    "evidence_policy",
    "outcomes",
    "problems",
    "source",
    "summary_version"
  ],
  "properties": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_types",
        "cross_artifact_problems",
        "evaluators",
        "problems",
        "records"
      ],
      "properties": {
        "artifact_types": {"$ref": "#/$defs/counts"},
        "cross_artifact_problems": {"type": "integer", "minimum": 0},
        "evaluators": {"$ref": "#/$defs/counts"},
        "problems": {"type": "integer", "minimum": 1},
        "records": {"type": "integer", "minimum": 1}
      }
    },
    "evidence_policy": {"const": "descriptive_per_record_no_truth_labels"},
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_evidence", "statuses", "witnesses"],
      "properties": {
        "decision_evidence": {"$ref": "#/$defs/counts"},
        "statuses": {"$ref": "#/$defs/counts"},
        "witnesses": {"type": "integer", "minimum": 0}
      }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_types", "problem_id", "records", "statuses"],
        "properties": {
          "artifact_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["symbolic_expression", "callable_model"]}
          },
          "problem_id": {"type": "string", "minLength": 1},
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "artifact_type",
                "decision_evidence",
                "evaluator",
                "record_id",
                "status",
                "witness_present"
              ],
              "properties": {
                "artifact_id": {"type": "string", "minLength": 1},
                "artifact_type": {"enum": ["symbolic_expression", "callable_model"]},
                "decision_evidence": {
                  "enum": ["EXACT", "RIGOROUS_BOUND", "EMPIRICAL", null]
                },
                "evaluator": {"enum": ["pdecert_symbolic", "pdecert_autodiff"]},
                "record_id": {"type": "string", "minLength": 1},
                "status": {"enum": ["PROVED", "REFUTED", "INCONCLUSIVE"]},
                "witness_present": {"type": "boolean"}
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"artifact_type": {"const": "symbolic_expression"}},
                    "required": ["artifact_type"]
                  },
                  "then": {
                    "properties": {"evaluator": {"const": "pdecert_symbolic"}}
                  }
                },
                {
                  "if": {
                    "properties": {"artifact_type": {"const": "callable_model"}},
                    "required": ["artifact_type"]
                  },
                  "then": {
                    "properties": {
                      "decision_evidence": {"enum": ["EMPIRICAL", null]},
                      "evaluator": {"const": "pdecert_autodiff"},
                      "status": {"enum": ["REFUTED", "INCONCLUSIVE"]}
                    }
                  }
                }
              ]
            }
          },
          "statuses": {"$ref": "#/$defs/counts"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atlas_name",
        "atlas_sha256",
        "evaluation_sha256",
        "evaluation_version"
      ],
      "properties": {
        "atlas_name": {"type": "string", "minLength": 1},
        "atlas_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluation_version": {"const": 1}
      }
    },
    "summary_version": {"const": 1}
  },
  "$defs": {
    "counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    }
  }
}
