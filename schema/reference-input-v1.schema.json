{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oroikono/PDECert/schema/reference-input-v1.schema.json",
  "title": "Supplied reference-field comparison input, version 1",
  "description": "Structural validation only. The runtime additionally checks exact integer version syntax, UTF-8 strings, finite binary64 values, integer precision, aligned lengths, matching field names, total scalar budget, and file size. No model execution or PDE verification is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_input_version", "coordinates", "candidate", "reference",
    "problem_id", "candidate_id", "reference_id", "reference_description",
    "reference_uncertainty", "sampling_description"
  ],
  "properties": {
    "reference_input_version": {"type": "integer", "const": 1},
    "coordinates": {"$ref": "#/$defs/columns"},
    "candidate": {"$ref": "#/$defs/columns"},
    "reference": {"$ref": "#/$defs/columns"},
    "problem_id": {"$ref": "#/$defs/text"},
    "candidate_id": {"$ref": "#/$defs/text"},
    "reference_id": {"$ref": "#/$defs/text"},
    "reference_description": {"$ref": "#/$defs/text"},
    "reference_uncertainty": {"$ref": "#/$defs/text"},
    "sampling_description": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "columns": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/text"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000000,
        "items": {"type": "number"}
      }
    }
  }
}
