{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdecert.org/schema/source-receipt-v1.schema.json",
  "title": "PDECert current evaluator source receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity_scope",
    "runner_paths",
    "source_files_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "integrity_scope": {
      "const": "content_identity_only"
    },
    "runner_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_files_sha256": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
