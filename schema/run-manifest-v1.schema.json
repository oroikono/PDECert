{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oroikono/PDECert/schema/run-manifest-v1.schema.json",
  "title": "PDECert digest-bound run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "integrity_scope",
    "run_id",
    "problem",
    "candidate",
    "evaluator",
    "report"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "integrity_scope": { "const": "content_identity_only" },
    "run_id": { "type": "string", "minLength": 1 },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_id", "template"],
      "properties": {
        "problem_id": { "type": "string", "minLength": 1 },
        "template": { "$ref": "#/$defs/file" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "field_names", "file", "provenance"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "field_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "file": { "$ref": "#/$defs/file" },
        "provenance": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configuration", "environment"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configuration": { "type": "object" },
        "environment": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "report": { "$ref": "#/$defs/file" }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
