{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oroikono/PDECert/blob/main/schema/atlas-baseline-report-v1.schema.json",
  "title": "PDECert Atlas baseline report version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "atlas",
    "baseline_report_version",
    "evidence_policy",
    "records",
    "runtime"
  ],
  "properties": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_artifact_types",
        "accepted_solution_semantics",
        "configuration",
        "id",
        "version"
      ],
      "properties": {
        "accepted_artifact_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "accepted_solution_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "configuration": {"type": "object"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"const": "fixed_collocation"}}, "required": ["id"]},
          "then": {
            "properties": {
              "accepted_artifact_types": {
                "const": ["symbolic_expression"]
              },
              "accepted_solution_semantics": {
                "const": ["classical_strong"]
              },
              "configuration": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decimal_precision",
                  "include_conditions",
                  "max_evaluations",
                  "points_per_axis",
                  "sampling",
                  "tolerance"
                ],
                "properties": {
                  "decimal_precision": {
                    "type": "integer",
                    "minimum": 15,
                    "maximum": 100
                  },
                  "include_conditions": {"const": true},
                  "max_evaluations": {"const": 1000000},
                  "points_per_axis": {"type": "integer", "minimum": 2},
                  "sampling": {"const": "uniform_tensor_grid_including_endpoints"},
                  "tolerance": {"type": "number", "exclusiveMinimum": 0}
                }
              },
              "version": {"const": 1}
            }
          }
        }
      ]
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atlas_version", "name", "sha256"],
      "properties": {
        "atlas_version": {"const": 2},
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "baseline_report_version": {"const": 1},
    "evidence_policy": {"const": "method_specific_empirical_diagnostics_no_proof"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "evidence_kind",
          "evidence_level",
          "evaluations",
          "max_absolute_residual",
          "outcome",
          "problem_id",
          "reason",
          "record_id",
          "witness"
        ],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_type": {"enum": ["symbolic_expression", "callable_model"]},
          "evidence_kind": {
            "enum": ["EMPIRICAL_PASS", "NUMERICAL_THRESHOLD_EXCEEDANCE", "ABSTENTION"]
          },
          "evidence_level": {"enum": ["EMPIRICAL", null]},
          "evaluations": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "null"}
            ]
          },
          "max_absolute_residual": {
            "oneOf": [
              {"type": "number", "minimum": 0},
              {"const": "infinity"},
              {"type": "null"}
            ]
          },
          "outcome": {"enum": ["pass", "fail", "unsupported"]},
          "problem_id": {"type": "string", "minLength": 1},
          "reason": {"type": ["string", "null"]},
          "record_id": {"type": "string", "minLength": 1},
          "witness": {
            "oneOf": [
              {"$ref": "#/$defs/witness"},
              {"type": "null"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "pass"}}, "required": ["outcome"]},
            "then": {
              "properties": {
                "evidence_kind": {"const": "EMPIRICAL_PASS"},
                "evidence_level": {"const": "EMPIRICAL"},
                "evaluations": {"type": "integer", "minimum": 1},
                "max_absolute_residual": {"type": "number", "minimum": 0},
                "reason": {"type": "null"},
                "witness": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "fail"}}, "required": ["outcome"]},
            "then": {
              "properties": {
                "evidence_kind": {"const": "NUMERICAL_THRESHOLD_EXCEEDANCE"},
                "evidence_level": {"const": "EMPIRICAL"},
                "evaluations": {"type": "integer", "minimum": 1},
                "max_absolute_residual": {
                  "oneOf": [
                    {"type": "number", "minimum": 0},
                    {"const": "infinity"}
                  ]
                },
                "reason": {"type": "null"},
                "witness": {"$ref": "#/$defs/witness"}
              }
            }
          },
          {
            "if": {
              "properties": {"outcome": {"const": "unsupported"}},
              "required": ["outcome"]
            },
            "then": {
              "properties": {
                "evidence_kind": {"const": "ABSTENTION"},
                "evidence_level": {"type": "null"},
                "evaluations": {"type": "null"},
                "max_absolute_residual": {"type": "null"},
                "reason": {"type": "string", "minLength": 1},
                "witness": {"type": "null"}
              }
            }
          }
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mpmath_version", "pdecert_version", "python_version", "sympy_version"],
      "properties": {
        "mpmath_version": {"type": "string", "minLength": 1},
        "pdecert_version": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "sympy_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_residual",
        "constraint",
        "constraint_source",
        "sampled_inputs"
      ],
      "properties": {
        "absolute_residual": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"const": "infinity"}
          ]
        },
        "constraint": {"type": "string", "minLength": 1},
        "constraint_source": {"type": "string", "minLength": 1},
        "sampled_inputs": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      }
    }
  }
}
